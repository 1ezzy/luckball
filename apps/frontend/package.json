{
	"name": "luckball-frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "NODE_ENV=production vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"start": "node build",
		"db:migrate": "tsx scripts/migrate.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.1",
		"@types/pg": "^8.20.0",
		"dotenv": "^17.4.2",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.7.0",
		"prettier": "^3.8.4",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.3",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.1",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.62.0",
		"vite": "^8.3.0"
	},
	"dependencies": {
		"@faker-js/faker": "^9.9.0",
		"@growthbook/growthbook": "^1.7.0",
		"@layerstack/tailwind": "2.0.0-next.15",
		"@layerstack/utils": "2.0.0-next.12",
		"@lucide/svelte": "1.43.0",
		"@luckball/drizzle-client": "workspace:*",
		"@luckball/game-logic": "workspace:*",
		"@luckball/valkey-client": "workspace:*",
		"@sveltejs/adapter-node": "^5.5.7",
		"better-auth": "^1.7.5",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"iovalkey": "^0.3.3",
		"layerchart": "2.0.0-next.27",
		"postgres": "^3.4.9",
		"svelte-ux": "2.0.0-next.13",
		"tsx": "^4.22.4"
	},
	"packageManager": "pnpm@12.4.2",
	"engines": {
		"node": ">=22.12.0"
	}
}
