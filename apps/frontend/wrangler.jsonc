{
	"name": "luckball",
	"compatibility_date": "2025-05-05",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./.svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"build": {
		"command": "pnpm run build"
	},
	"observability": {
		"enabled": true
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "1194939d56b34346a0b9cfd007e21ff5"
		}
	]
}
