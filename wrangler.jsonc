{
	"name": "luckball",
	"compatibility_date": "2025-05-05",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./src/worker.ts",
	"upload_source_maps": true,
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"build": {
		"command": "pnpm run build"
	},
	"triggers": {
		"crons": ["*/1 * * * *"]
	},
	"observability": {
		"enabled": true
	}
}
