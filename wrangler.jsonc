{
	"name": "luckball",
	"compatibility_date": "2024-09-23",
	"compatibility_flags": ["nodejs_compat"],
	"main": "src/index.ts",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"build": {
		"command": "pnpm run build"
	},
	"triggers": {
		"crons": ["30 21 * * 5"]
	}
}
