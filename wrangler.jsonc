{
	"name": "luckball",
	"compatibility_date": "2025-05-05",
	"compatibility_flags": ["nodejs_compat"],
	"main": "src/index.ts",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"build": {
		"command": "pnpm run build"
	},
	"triggers": {
		"crons": ["10 23 * * 6"]
	}
}
